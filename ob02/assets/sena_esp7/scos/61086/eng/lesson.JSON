eedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"contents": [{"content": "Instructions: \n<span class=\"bullet\">Proofread the sentence.</span> \n<span class=\"bullet\">Click on the incorrect word.</span> \n<span class=\"bullet\">Type in the correct word to complete the sentence.\n</span> <span class=\"bullet\">Use capital letters where necessary.</span>\n", "type": "text"}], "type": "post_instructions"}], "id": 10, "type": "GIW"}, {"questions": [{"responses": [{"_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0, "correct": 0}, {"_data": [{"content": "", "type": "text"}], "selected": 0, "id": 1, "correct": 1}], "_data": [{"contents": [{"content": "", "type": "text"}], "type": "question"}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"contents": [], "type": "instructions"}, {"contents": [{"content": "Quiz", "type": "group_name"}], "type": "group"}, {"content": {"incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 11, "type": "RSLT"}, {"questions": [{"responses": [{"_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0, "correct": 1}], "_data": [{"contents": [{"content": "enpe7n3le01ob02re7pdf01.pdf", "type": "pdf"}], "type": "question"}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"contents": [{"content": "Let's define data abstraction!", "type": "text"}], "type": "instructions"}, {"contents": [{"content": "Take Away", "type": "group_name"}], "type": "group"}, {"content": {"incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}], "type": "learning_skills"}, {"contents": [{"content": "<span class=\"italic\">Instructions: Complete the following steps. Fill in the Self-Assessment.</span>", "type": "text"}], "type": "post_instructions"}], "id": 12, "type": "DWS"}], "_data": [{"contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}], "type": "lab_options"}], "stimuli": [{"_data": [], "contents": [{}], "template_override": 1, "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "contents": [{"value": {"coverimg": "enpe7n3le01ob02re2img01.jpg", "images": [{"time": "0", "text": "<b>Co-worker</b>: Welcome to our team, Tim. Please open your handbook on page 34, we need to explain to you the significance of data abstraction. Our team works mainly with abstract data types. </br>\n<b>Tim</b>: What is it?</br>\n<b>Co-worker</b>: Abstract data types is a technique to abstract data. To abstract data means to specify, simplify, and encapsulate data, in order to obtain a \u201cgeneric\u201d type with particular storage features and specific operations to perform on the data type. </br>\n<b>Tim</b>: Can you please be more specific?", "image": "enpe7n3le01ob02re2img01.jpg", "id": 0}, {"time": "34000", "text": "<b>Co-worker</b>: To have a complete abstract stack data type, it has to include a structure for sorting data, as a list, an array, or a queue, and a set of operations such as adding or removing integers from the stack.</br>\n<b>Tim</b>: I see. What else should I consider?</br>\n<b>Co-worker</b>: The main advantage of abstracting data types is that it splits structure and functionality from implementation. So you can modify the data type class, or embodiment, without affecting any program. </br>\n<b>Tim</b>: What do you mean by class?</br>\n<b>Co-worker</b>: The data class is the encapsulation of an object, it's the code-template for the creation of objects; it provides the variables and the behaviors or operations that the programmer decides.", "image": "enpe7n3le01ob02re2img02.jpg", "id": 1}, {"time": "87000", "text": "<b>Tim</b>: And what do you mean by object? </br>\n<b>Co-worker</b>: An object is a particular entity of data, to access the data contained in an object, we must have the functions (the class) of the abstract data type. Programmers can change those functions without altering the implementation of the object.</br>\n<b>Tim</b>: Mention more advantages this technique offers, please.  </br>\n<b>Co-worker</b>: Another pro of abstracting data types is the inheritance. This means that you can have better-derived versions with the printing functions of the original one.", "image": "enpe7n3le01ob02re2img03.jpg", "id": 2}], "audiosrc": "enpe7n3le01ob02re2aud01"}, "type": "slideshow"}], "title": "", "id": 1, "type": "audio"}], "id": 0, "type": "scholar"}]}
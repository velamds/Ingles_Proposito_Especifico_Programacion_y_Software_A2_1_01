mpts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 10, "type": "RSLT"}, {"questions": [{"responses": [{"_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0, "correct": 1}], "_data": [{"contents": [{"content": "enpe7n3le01ob03re7pdf01.pdf", "type": "pdf"}], "type": "question"}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"contents": [{"content": "Now it's your turn to find more information related to data acquisition. ", "type": "text"}], "type": "instructions"}, {"contents": [{"content": "Take Away", "type": "group_name"}], "type": "group"}, {"content": {"incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}], "type": "learning_skills"}, {"contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}], "type": "post_instructions"}], "id": 11, "type": "DWS"}], "_data": [{"contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}], "type": "lab_options"}], "stimuli": [{"_data": [], "contents": [{}], "template_override": 1, "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "contents": [{"value": {"coverimg": "enpe7n3le01ob03re2img01.jpg", "images": [{"time": "0", "text": "Data acquisition is the process of collecting real-time data (physical phenomena) and digitalize it in real time to manipulate digital representations through the computer.  Data acquisition consists of recording facts from reality using a device (a microphone, a recorder) which sends signals to the computer; it processes the data and presents it on the computer screen. There is a variety of DAQs which turns into different facts concerning the acquisition of data; for example, the keyboard. When we press a key, we are sending a signal which is processed by the computer and finally displayed on the screen as a symbol (a letter or a number) interpreted by the user. When we move the mouse, it sends a signal that allows us to see the cursor on the screen when navigating websites. Digital cameras also convert light levels; when downloading a picture, it becomes understandable and easy to interpret as digital images.", "image": "enpe7n3le01ob03re2img01.jpg", "id": 0}, {"time": "80500", "text": "There are also specialized DAQs to measure physical phenomena and to automatically convert those measurements into digital data to be downloaded. It is represented by using different types of software stored in the memory or in any other hard-copy output device. The datum is actually sent to a computer which uses software to process and display the data using graphs or other resources, depending on the user's settings.", "image": "enpe7n3le01ob03re2img02.jpg", "id": 1}, {"time": "113000", "text": "In certain environments, especially in the field of science and engineering, data acquisition devices help people collect real-time representations.  They alert users if there is a change in the data collected in order to adjust any physical fact, as the temperature or light. Also, in the aviation field, the usage of automated systems is increasing, as planes functionalities depend on real-time data acquisition.", "image": "enpe7n3le01ob03re2img03.jpg", "id": 2}], "audiosrc": "enpe7n3le01ob03re2aud01"}, "type": "slideshow"}], "title": "", "id": 1, "type": "audio"}], "id": 0, "type": "scholar"}]}